# ============================================================
# Unscripted — variáveis de ambiente
# Copie este arquivo como .env e preencha os valores reais.
# NUNCA versione o .env com valores reais.
# ============================================================

# --- LLM (multi-provider — ADR-045) -------------------------
# Seleciona qual provider o backend usa. Cada provider tem dois
# modelos: REASONING (Referee, structured output) e NARRATIVE
# (Narrator/NPC, streaming de prosa). Se NARRATIVE estiver vazio,
# faz fallback para o REASONING (single-model preservado).
#
# Opções: gemini_aistudio | groq | openai
LLM_PROVIDER=gemini_aistudio

# --- Gemini (Google AI Studio) ------------------------------
# Chave da API (obter em https://aistudio.google.com/).
# Free tier: 20 RPD em gemini-2.5-flash — esgota rápido em uso real.
GEMINI_API_KEY=
GEMINI_MODEL_REASONING=gemini-2.5-flash
# Vazio → fallback para REASONING.
GEMINI_MODEL_NARRATIVE=

# --- Groq (via LiteLlm — free tier generoso) ----------------
# Chave da API (obter em https://console.groq.com/).
# Free tier: 14.4K RPD em llama-3.1-8b-instant; 1K RPD nos modelos
# maiores. Split por agente aproveita as duas quotas (ver ADR-045).
GROQ_API_KEY=
# Default REASONING (Referee). Alternativas: qwen/qwen3-32b,
# openai/gpt-oss-120b, openai/gpt-oss-20b.
GROQ_MODEL_REASONING=llama-3.3-70b-versatile
# Default NARRATIVE (Narrator/NPC) — modelo leve, alta quota.
GROQ_MODEL_NARRATIVE=llama-3.1-8b-instant

# --- OpenAI (via LiteLlm — pago, sem free tier real) --------
# Chave da API (obter em https://platform.openai.com/).
# gpt-4o-mini custa ~$0.001/turno; benchmark de qualidade.
OPENAI_API_KEY=
OPENAI_MODEL_REASONING=gpt-4o-mini
# Vazio → fallback para REASONING.
OPENAI_MODEL_NARRATIVE=

# --- Embedding ----------------------------------------------
# Seleciona a implementação de provider de embedding.
# Opções v1: local (sentence-transformers rodando no container)
EMBEDDING_PROVIDER=local

# Nome do modelo de embedding local (sentence-transformers).
# Multilíngue desde o início (ADR-033): o conteúdo do projeto é PT-BR.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Dimensão do vetor produzido pelo modelo acima. Trocar o modelo por um
# de outra dimensão exige nova migration + re-ingestão completa.
EMBEDDING_DIM=384

# Quantos trechos do corpus de lore o NarratorAgent recebe a cada turno.
RAG_TOP_K_LORE=3

# Quantos trechos do corpus de regras o RefereeAgent recebe.
RAG_TOP_K_RULES=5

# --- Banco de dados (Postgres + pgvector) -------------------
POSTGRES_USER=unscripted
POSTGRES_PASSWORD=changeme
POSTGRES_DB=unscripted
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend (FastAPI) --------------------------------------
# Porta em que o servidor escuta dentro do container.
BACKEND_PORT=8000

# Origem(ns) permitida(s) para CORS — URL do frontend.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Frontend (Vite) ----------------------------------------
# Porta em que o servidor de dev do Vite escuta dentro do container.
FRONTEND_PORT=5173

# --- Ambiente -----------------------------------------------
# "development" ou "production"
ENVIRONMENT=development

# --- Voz — STT (jogador fala) (ADR-047) ---------------------
# Speech-to-Text: transcreve o áudio do mic em texto.
# Opções: stub (responde vazio) | groq (Whisper via litellm)
#
# Groq free tier oferece whisper-large-v3-turbo com quota generosa.
# Reaproveita GROQ_API_KEY definida acima.
STT_PROVIDER=stub
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Voz — TTS (mestre narra) (ADR-047, ADR-049) ------------
# Text-to-Speech: gera a narração falada quando o jogador habilita
# o toggle no frontend.
# Opções: stub (responde vazio) | openai (gpt-4o-mini-tts via litellm)
#
# gpt-4o-mini-tts custa ~$0.015 por 1K caracteres (~$0.001/turno).
# PT-BR nativo, suporta streaming. Reaproveita OPENAI_API_KEY acima.
TTS_PROVIDER=stub
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Vozes disponíveis: alloy, sage, echo, coral, shimmer (e outras).
# Default `echo` cravado pelo ADR-049: tom grave e sóbrio que casa
# com a estética de "livro-jogo editorial" do Unscripted — favorece
# a sensação de mestre conduzindo a narrativa em vez de IA falando.
OPENAI_TTS_VOICE=echo
